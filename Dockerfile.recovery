FROM golang:1.27 AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -o recovery-manager ./cmd/recovery-test

FROM alpine:3.22

WORKDIR /app

COPY --from=builder /app/recovery-manager /app/recovery-manager

EXPOSE 5000

CMD ["/app/recovery-manager"]